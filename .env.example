# Copy to .env and replace every value marked REPLACE_ME before starting Compose.
POSTGRES_DB=scip
POSTGRES_USER=scip
POSTGRES_PASSWORD=REPLACE_ME_DATABASE_PASSWORD
GRAFANA_ADMIN_PASSWORD=REPLACE_ME_GRAFANA_PASSWORD

SCIP_ENVIRONMENT=development
SCIP_DATABASE_URL=postgresql+asyncpg://scip:REPLACE_ME_DATABASE_PASSWORD@postgres:5432/scip
SCIP_JWT_SIGNING_KEY=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SCIP_JWT_ISSUER=secure-cloud-infrastructure-platform
SCIP_JWT_AUDIENCE=secure-cloud-platform-api
SCIP_JWT_KEY_ID=compose-hs256-v1
SCIP_ACCESS_TOKEN_TTL_SECONDS=900
SCIP_ALLOWED_HOSTS=localhost,127.0.0.1,api
SCIP_CORS_ORIGINS=
SCIP_AUTO_CREATE_SCHEMA=false
SCIP_DOCS_ENABLED=true
SCIP_METRICS_ENABLED=true
SCIP_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces

SCIP_BOOTSTRAP_ADMIN_USERNAME=admin
SCIP_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_ME_ADMIN_PASSWORD_14_CHARS_MINIMUM
